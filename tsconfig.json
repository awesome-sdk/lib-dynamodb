{
  "extends": "@tsconfig/recommended/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "incremental": true,
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "outDir": "dist",
    "baseUrl": "./src",
    "paths": {
      "~/*": ["*"]
    },
    "types": ["vitest/globals"]
  },
  "include": ["src", "tests"],
  "exclude": ["dist"]
}
